# ==============================================================================
# Panadiga Engineering Ecosystem - Universal .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Rust & Cargo Build Artifacts
# ------------------------------------------------------------------------------
/target/
Cargo.lock.orig
**/*.rs.bk

# ------------------------------------------------------------------------------
# 2. Desktop Application (Tauri v2 + Vite + React + TypeScript)
# ------------------------------------------------------------------------------
**/node_modules/
**/dist/
**/dist-android/
.vite/
*.tsbuildinfo
*.timestamp-*.mjs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. Test Runners, Coverage & Quality Reports
# ------------------------------------------------------------------------------
/test-results/
apps/desktop/test-results/
apps/desktop/playwright-report/
.jscpd-report/
.mypy_cache/
.pytest_cache/
.ruff_cache/
coverage/
.nyc_output/
test_out.txt
AUDIT_DOSSIER_*.md

# ------------------------------------------------------------------------------
# 4. Raspberry Pi Pico Firmware & CMake Build Artifacts (RP2040 / RP2350)
# ------------------------------------------------------------------------------
pico-sdk/
firmware/pico-p7501/build*/
firmware/pico-p7501/*.uf2
firmware/pico-p7501/*.elf
firmware/pico-p7501/*.bin
firmware/pico-p7501/*.hex
firmware/pico-p7501/*.map
firmware/pico-p7501/*.dis
compile_commands.json
.ninja_*
CMakeCache.txt
CMakeFiles/

# ------------------------------------------------------------------------------
# 5. Python Bytecode, Caches & Virtual Environments
# ------------------------------------------------------------------------------
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
venv/
env/

# ------------------------------------------------------------------------------
# 6. Local Binaries, Deployments & Third-Party Portable Tools
# ------------------------------------------------------------------------------
*.exe
*.keystore
apps/desktop/src-tauri/gen/android/keystore/
.env*
*.pem
*.key
*.jks
tools/HxD/app/

# ------------------------------------------------------------------------------
# 7. Proprietary & Large Binary Dumps (>100MB exceeds GitHub limits)
# ------------------------------------------------------------------------------
firmware_and_images/**/*.bin
firmware_and_images/**/*.zip
firmware_and_images/**/*.7z
firmware_and_images/**/*.FRM
firmware_and_images/**/*.frm
firmware_and_images/**/*.jp2
firmware_and_images/*.bin
firmware_and_images/*.zip
firmware_and_images/*.FRM
firmware_and_images/*.frm
firmware_and_images/extracted_partitions/
firmware_and_images/sd_unbrick_kit_*/
keys.local.ukf
*.local.ukf
!firmware_and_images/sd_unbrick_kit/
!firmware_and_images/sd_unbrick_kit/SHA256SUMS.txt
!firmware_and_images/sd_unbrick_kit/LEIA_ME_CARTAO_SD.txt
!firmware_and_images/sd_unbrick_kit/prepare_report.json
!firmware_and_images/sd_unbrick_kit/DIGADIAG.FRM
!firmware_and_images/sd_unbrick_kit/PANA__SD.FRM
!firmware_and_images/eh55_ifodev2_m6930lb_2048b.bin
!firmware_and_images/eh55_nvram_64k_raw.bin
!firmware_and_images/eh55_loader_ver061_256k.bin
!firmware_and_images/eh55_nor_8mb_ic5001_dump.bin
!firmware_and_images/eh55_nor_8mb_ic5001_repaired.bin
!firmware_and_images/**/README.md
!firmware_and_images/*.bin.gz

# Runtime & Bench Backups
/backups/

# ------------------------------------------------------------------------------
# 8. Operating System & Temporary Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.tmp
*.bak
scratch_*.log

# ------------------------------------------------------------------------------
# 9. IDE & Code Editors
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*~

# Generated Win32DiskImager raw disk images
firmware_and_images/*.img

# ------------------------------------------------------------------------------
# 10. Ghidra Java Analyzers (ignore compiled bytecode, keep .java sources tracked)
# ------------------------------------------------------------------------------
*.class
!tools/ghidra/java/
!tools/ghidra/java/**/*.java
!tools/ghidra/java/README.md
