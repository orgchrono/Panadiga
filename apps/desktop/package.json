{
  "name": "panadiga",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:android": "vite --mode android",
    "build": "tsc && vite build",
    "build:android": "tsc && vite build --mode android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "oxlint src --deny-warnings && tsc --noEmit",
    "uxlint": "ux-guard scan src --fail-on info",
    "jscpd": "jscpd src --threshold 0",
    "check:ci": "run-p -l lint test",
    "check": "run-p -l lint uxlint jscpd test",
    "check:all": "run-p -l lint uxlint jscpd test test:e2e",
    "preview": "vite preview",
    "tauri": "npx @tauri-apps/cli"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@reduxjs/toolkit": "^2.14.0",
    "@tauri-apps/api": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.10.1",
    "i18next": "^27.0.1",
    "lucide-react": "^0.460.0",
    "pino": "^10.4.0",
    "react": "^18.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.0",
    "react-redux": "^9.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@orgchrono/oxlint-plugin": "file:../../packages/oxlint-plugin-panadiga",
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "jscpd": "^5.4.2",
    "jsdom": "^31.0.0",
    "npm-run-all2": "^9.0.4",
    "oxlint": "^1.93.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^7.0.2",
    "ux-guard": "^0.1.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "zod": "$zod",
    "typescript": "$typescript",
    "vite": "$vite"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
