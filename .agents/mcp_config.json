{
  "mcpServers": {
    "panadiga-tools": {
      "command": "python",
      "args": ["-m", "scripts.panadiga_cli_bridge", "mcp"],
      "env": {
        "PANADIGA_WORKSPACE_ROOT": "."
      }
    },
    "ghidra": {
      "command": "python",
      "args": ["-m", "scripts.panadiga_cli_bridge", "ghidra-mcp", "--ghidra-server", "http://127.0.0.1:8080/"]
    }
  }
}
