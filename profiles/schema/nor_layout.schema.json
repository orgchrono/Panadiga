{
  "$defs": {
    "ClaimEvidence": {
      "additionalProperties": false,
      "description": "Evidence bundle bound to one architectural entity or model claim axis.",
      "properties": {
        "notes": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceSource"
          },
          "type": "array"
        },
        "tier": {
          "$ref": "#/$defs/EvidenceTier"
        }
      },
      "required": [
        "tier"
      ],
      "type": "object"
    },
    "EvidenceSource": {
      "additionalProperties": false,
      "description": "Primary source reference justifying a claim in a hardware profile.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "notes": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "type": "string"
        },
        "sha256": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "type": "object"
    },
    "EvidenceTier": {
      "description": "Empirical confidence tier attached to each individual hardware/firmware claim.",
      "oneOf": [
        {
          "const": "community_unverified",
          "description": "T0: Forum report, size heuristic, or unverified note (C0 read-only unless offline LabOverride).",
          "type": "string"
        },
        {
          "const": "service_manual_only",
          "description": "T1: Verified against official Matsushita/Panasonic service manuals or schematics (no binary dump).",
          "type": "string"
        },
        {
          "const": "official_frm_verified",
          "description": "T2: Verified from an official `.FRM` / CDN firmware package (proves train/TOC/load VA, not NOR layout).",
          "type": "string"
        },
        {
          "const": "physical_dump_verified",
          "description": "T3: Verified from a full physical chip dump with SHA-256 and static layout analysis.",
          "type": "string"
        },
        {
          "const": "bench_verified",
          "description": "T4: Operated and verified live on bench hardware with captured telemetry and before/after hashes.",
          "type": "string"
        }
      ]
    },
    "NorRegion": {
      "additionalProperties": false,
      "description": "Contiguous sector-aligned region inside a [`NorLayoutProfile`].",
      "properties": {
        "end_offset": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/NorRegionKind"
        },
        "policy": {
          "$ref": "#/$defs/NorRegionPolicy"
        },
        "signature": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegionSignature"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "start_offset": {
          "type": "string"
        },
        "tag": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "start_offset",
        "end_offset",
        "policy"
      ],
      "type": "object"
    },
    "NorRegionKind": {
      "description": "Semantic role of a physical byte span in NOR Flash (`IC5001`).",
      "enum": [
        "ipl",
        "erased",
        "extrhead",
        "main_xip",
        "bgo",
        "nor_fs",
        "eemul",
        "vendor_nvram",
        "unknown"
      ],
      "type": "string"
    },
    "NorRegionPolicy": {
      "description": "Fail-closed write policy attached to a NOR region.",
      "enum": [
        "read_only_permanent",
        "gated_upper_nor",
        "nvram_sanitize",
        "read_only_reference"
      ],
      "type": "string"
    },
    "RegionSignature": {
      "additionalProperties": false,
      "description": "Structural header marker expected at a region sector head (e.g., byte `[5] == 0xF1`).",
      "properties": {
        "marker_byte_offset": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "marker_value": {
          "type": "string"
        }
      },
      "required": [
        "marker_byte_offset",
        "marker_value"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Explicit Flash NOR partitioning tying a [`crate::FirmwareTrainProfile`] to a [`crate::FlashChipProfile`].",
  "properties": {
    "evidence": {
      "$ref": "#/$defs/ClaimEvidence"
    },
    "flash_ref": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "regions": {
      "items": {
        "$ref": "#/$defs/NorRegion"
      },
      "type": "array"
    },
    "train_ref": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "flash_ref",
    "train_ref",
    "regions",
    "evidence"
  ],
  "title": "NorLayoutProfile",
  "type": "object"
}
