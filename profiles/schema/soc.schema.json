{
  "$defs": {
    "BusWindow": {
      "additionalProperties": false,
      "description": "Physical bus aperture window exposed by an SoC silicon block.",
      "properties": {
        "base": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "uncached_alias_base": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "base",
        "size"
      ],
      "type": "object"
    },
    "ClaimEvidence": {
      "additionalProperties": false,
      "description": "Evidence bundle bound to one architectural entity or model claim axis.",
      "properties": {
        "notes": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceSource"
          },
          "type": "array"
        },
        "tier": {
          "$ref": "#/$defs/EvidenceTier"
        }
      },
      "required": [
        "tier"
      ],
      "type": "object"
    },
    "EvidenceSource": {
      "additionalProperties": false,
      "description": "Primary source reference justifying a claim in a hardware profile.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "notes": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "type": "string"
        },
        "sha256": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "type": "object"
    },
    "EvidenceTier": {
      "description": "Empirical confidence tier attached to each individual hardware/firmware claim.",
      "oneOf": [
        {
          "const": "community_unverified",
          "description": "T0: Forum report, size heuristic, or unverified note (C0 read-only unless offline LabOverride).",
          "type": "string"
        },
        {
          "const": "service_manual_only",
          "description": "T1: Verified against official Matsushita/Panasonic service manuals or schematics (no binary dump).",
          "type": "string"
        },
        {
          "const": "official_frm_verified",
          "description": "T2: Verified from an official `.FRM` / CDN firmware package (proves train/TOC/load VA, not NOR layout).",
          "type": "string"
        },
        {
          "const": "physical_dump_verified",
          "description": "T3: Verified from a full physical chip dump with SHA-256 and static layout analysis.",
          "type": "string"
        },
        {
          "const": "bench_verified",
          "description": "T4: Operated and verified live on bench hardware with captured telemetry and before/after hashes.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Concrete SoC silicon part number (`MN2DS0009`, `MN2DS0012-H`, `MN2DS00151DB`, etc.).",
  "properties": {
    "bus_windows": {
      "items": {
        "$ref": "#/$defs/BusWindow"
      },
      "type": "array"
    },
    "core_ref": {
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/ClaimEvidence"
    },
    "id": {
      "type": "string"
    },
    "lethal_mmio": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "mmio": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "type": "object"
    },
    "p7501_nsw5v_hiz_only": {
      "type": "boolean"
    },
    "p7501_uart_baud": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "part_number": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "part_number",
    "core_ref",
    "bus_windows",
    "p7501_uart_baud",
    "p7501_nsw5v_hiz_only",
    "evidence"
  ],
  "title": "SocProfile",
  "type": "object"
}
