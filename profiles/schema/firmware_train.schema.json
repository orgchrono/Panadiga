      "required": [
        "build_id",
        "slot_name",
        "frm_version_u16",
        "base_va",
        "unpacked_size",
        "native_bgo_geometry_id"
      ],
      "type": "object"
    },
    "OffsetRange": {
      "additionalProperties": false,
      "description": "Half-open byte offset range `[start, end)` inside an unpacked `PROG` binary.",
      "properties": {
        "end": {
          "type": "string"
        },
        "start": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "PanaRebuildRecipe": {
