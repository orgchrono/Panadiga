          "type": [
            "string",
            "null"
          ]
        },
        "frm_version_u16": {
          "type": "string"
        },
        "model_markers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "native_bgo_detect_va": {
          "type": [
            "string",
            "null"
          ]
        },
        "native_bgo_flash_base_va": {
          "type": [
            "string",
            "null"
          ]
        },
        "native_bgo_geometry_id": {
          "type": "string"
