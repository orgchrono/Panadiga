        }
      ],
      "default": null
    },
    "loader_profile_key": {
      "type": "string"
    },
    "loader_version": {
      "type": "string"
    },
    "main_builds": {
      "items": {
        "$ref": "#/$defs/MainBuildSpec"
      },
      "type": "array"
    },
    "main_load_va": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "media_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "pana_rebuild_recipe": {
      "anyOf": [
        {
          "$ref": "#/$defs/PanaRebuildRecipe"
        },
        {
          "type": "null"
        }
      ]
    },
    "prog_load_va": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "prog_sata_bridge_reset_spec": {
      "anyOf": [
        {
          "$ref": "#/$defs/SataBridgeResetSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "sd_boot_filenames": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "soc_core_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage2_boot_spec": {
      "anyOf": [
        {
          "$ref": "#/$defs/Stage2BootSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "symbols": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "type": "object"
