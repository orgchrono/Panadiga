        "supports_bgo_retarget_to": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unpacked_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "unpacked_size": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
