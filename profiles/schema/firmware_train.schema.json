  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Firmware build/train profile independent of silicon ISA (`loader_ver061`, `loader_ver018`, `prog071`, etc.).",
  "properties": {
    "bgo_retarget_spec": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProgBgoRetargetSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "digadiag_raw_bytes": {
      "default": null,
