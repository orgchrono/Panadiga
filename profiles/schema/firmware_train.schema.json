{
  "$defs": {
    "AddressReloc": {
      "additionalProperties": false,
      "description": "32-bit SDRAM pointer relocation mapping (`from -> to`).",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "BinaryPatchSiteSpec": {
      "additionalProperties": false,
      "description": "Single fail-closed machine-code patch site inside a firmware image (`VA`, expected bytes, replacement).",
      "properties": {
        "description": {
          "type": "string"
        },
        "expect_hex": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "replace_hex": {
          "type": "string"
        },
        "symbol_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "va": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "va",
        "expect_hex",
        "replace_hex"
      ],
      "type": "object"
    },
    "BytePatchEntry": {
      "additionalProperties": false,
      "description": "Verified single-byte immediate patch (`offset: expect -> replace`) inside a retargeted `PROG`.",
      "properties": {
        "expect": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "offset": {
          "type": "string"
        },
        "replace": {
          "type": "string"
        }
      },
      "required": [
        "offset",
        "expect",
        "replace"
      ],
      "type": "object"
    },
    "ClaimEvidence": {
      "additionalProperties": false,
      "description": "Evidence bundle bound to one architectural entity or model claim axis.",
      "properties": {
        "notes": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceSource"
          },
          "type": "array"
        },
        "tier": {
          "$ref": "#/$defs/EvidenceTier"
        }
      },
      "required": [
        "tier"
      ],
      "type": "object"
    },
    "DigadiagSpec": {
      "additionalProperties": false,
      "description": "SD stage-1.5 `DIGADIAG.FRM` specification declared per firmware train.",
      "properties": {
        "bgo_geometry_target": {
          "type": "string"
        },
        "entry_va": {
          "type": "string"
        },
        "exact_bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "filename": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "fvu_decoupled_mode": {
          "type": "string"
        },
        "load_va": {
          "type": "string"
        },
        "panamon1_entry_va": {
          "type": [
            "string",
            "null"
          ]
        },
        "sd_media_requirement": {
          "type": "string"
        },
        "trust_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/DigadiagTrustModel"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "format",
        "filename",
        "exact_bytes",
        "load_va",
        "entry_va",
        "bgo_geometry_target",
        "fvu_decoupled_mode",
        "sd_media_requirement"
      ],
      "type": "object"
    },
    "DigadiagTrustModel": {
      "description": "Cryptographic / integrity trust model verified for stage-1.5 `DIGADIAG.FRM` boot.",
      "enum": [
        "checksum32_only",
        "encrypted_toc",
        "rsa_signed",
        "unknown"
      ],
      "type": "string"
    },
    "EvidenceSource": {
      "additionalProperties": false,
      "description": "Primary source reference justifying a claim in a hardware profile.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "notes": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "type": "string"
        },
        "sha256": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "type": "object"
    },
    "EvidenceTier": {
      "description": "Empirical confidence tier attached to each individual hardware/firmware claim.",
      "oneOf": [
        {
          "const": "community_unverified",
          "description": "T0: Forum report, size heuristic, or unverified note (C0 read-only unless offline LabOverride).",
          "type": "string"
        },
        {
          "const": "service_manual_only",
          "description": "T1: Verified against official Matsushita/Panasonic service manuals or schematics (no binary dump).",
          "type": "string"
        },
        {
          "const": "official_frm_verified",
          "description": "T2: Verified from an official `.FRM` / CDN firmware package (proves train/TOC/load VA, not NOR layout).",
          "type": "string"
        },
        {
          "const": "physical_dump_verified",
          "description": "T3: Verified from a full physical chip dump with SHA-256 and static layout analysis.",
          "type": "string"
        },
        {
          "const": "bench_verified",
          "description": "T4: Operated and verified live on bench hardware with captured telemetry and before/after hashes.",
          "type": "string"
        }
      ]
    },
    "FrmContainerSpec": {
      "additionalProperties": false,
      "description": "Container and symmetric cipher parameters for `.FRM` / SD / CD recovery images.",
      "properties": {
        "cipher": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "key_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "official_frm_sha256": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "toc_entry_bytes": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "toc_size": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "LoaderFingerprint": {
      "additionalProperties": false,
      "description": "Expected bootloader banner fingerprint inside `0x000000..0x03FFFF`.",
      "properties": {
        "ascii_marker": {
          "type": "string"
        },
        "offset_end": {
          "type": "string"
        },
        "offset_start": {
          "type": "string"
        }
      },
      "required": [
        "offset_start",
        "offset_end",
        "ascii_marker"
      ],
      "type": "object"
    },
