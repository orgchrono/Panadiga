      "required": [
        "target_geometry_id",
        "expected_prog_size",
        "bgo_table_offset",
        "bgo_table_marker",
        "detect_logical_sectors",
        "detect_flash_base",
        "bgo_table_words",
        "bgo_sum_beq_offset",
        "nfrom_drv_start",
        "nfrom_drv_end",
        "nfrom_drv_uncompressed_bytes",
        "nfrom_drv_blob_relpath",
        "nfrom_drv_uncompressed_sha256",
        "nop_fill_byte",
        "bss_zero_end_offset",
        "orig_bss_zero_end",
        "target_bss_zero_end",
        "init2_call_offset",
        "orig_init2_rel32",
        "target_init2_rel32",
        "hi_ram_ranges",
        "hi_ram_relocs",
        "byte_patches"
      ],
      "type": "object"
