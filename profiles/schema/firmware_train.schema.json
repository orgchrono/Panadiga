        "nfrom_drv_uncompressed_sha256": {
          "type": "string"
        },
        "nop_fill_byte": {
          "type": "string"
        },
        "orig_bss_zero_end": {
          "type": "string"
        },
        "orig_init2_rel32": {
          "type": "string"
        },
        "target_bss_zero_end": {
          "type": "string"
        },
        "target_geometry_id": {
          "type": "string"
        },
        "target_init2_rel32": {
          "type": "string"
