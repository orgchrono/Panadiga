{
  "$defs": {
    "ClaimEvidence": {
      "additionalProperties": false,
      "description": "Evidence bundle bound to one architectural entity or model claim axis.",
      "properties": {
        "notes": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceSource"
          },
          "type": "array"
        },
        "tier": {
          "$ref": "#/$defs/EvidenceTier"
        }
      },
      "required": [
        "tier"
      ],
      "type": "object"
    },
    "EvidenceSource": {
      "additionalProperties": false,
      "description": "Primary source reference justifying a claim in a hardware profile.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "notes": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "type": "string"
        },
        "sha256": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "type": "object"
    },
    "EvidenceTier": {
      "description": "Empirical confidence tier attached to each individual hardware/firmware claim.",
      "oneOf": [
        {
          "const": "community_unverified",
          "description": "T0: Forum report, size heuristic, or unverified note (C0 read-only unless offline LabOverride).",
          "type": "string"
        },
        {
          "const": "service_manual_only",
          "description": "T1: Verified against official Matsushita/Panasonic service manuals or schematics (no binary dump).",
          "type": "string"
        },
        {
          "const": "official_frm_verified",
          "description": "T2: Verified from an official `.FRM` / CDN firmware package (proves train/TOC/load VA, not NOR layout).",
          "type": "string"
        },
        {
          "const": "physical_dump_verified",
          "description": "T3: Verified from a full physical chip dump with SHA-256 and static layout analysis.",
          "type": "string"
        },
        {
          "const": "bench_verified",
          "description": "T4: Operated and verified live on bench hardware with captured telemetry and before/after hashes.",
          "type": "string"
        }
      ]
    },
    "FrmContainerSpec": {
      "additionalProperties": false,
      "description": "Container and symmetric cipher parameters for `.FRM` / SD / CD recovery images.",
      "properties": {
        "cipher": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "key_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "official_frm_sha256": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "toc_entry_bytes": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "toc_size": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "LoaderFingerprint": {
      "additionalProperties": false,
      "description": "Expected bootloader banner fingerprint inside `0x000000..0x03FFFF`.",
      "properties": {
        "ascii_marker": {
          "type": "string"
        },
        "offset_end": {
          "type": "string"
        },
        "offset_start": {
          "type": "string"
        }
      },
      "required": [
        "offset_start",
        "offset_end",
        "ascii_marker"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Firmware build/train profile independent of silicon ISA (`loader_ver061`, `loader_ver018`, `prog071`, etc.).",
  "properties": {
    "digadiag_raw_bytes": {
      "default": null,
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "drv_load_va": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "$ref": "#/$defs/ClaimEvidence"
    },
    "frm": {
      "anyOf": [
        {
          "$ref": "#/$defs/FrmContainerSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "type": "string"
    },
    "loader_date": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "loader_fingerprint": {
      "anyOf": [
        {
          "$ref": "#/$defs/LoaderFingerprint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "loader_profile_key": {
      "type": "string"
    },
    "loader_version": {
      "type": "string"
    },
    "main_load_va": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "media_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "prog_load_va": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "sd_boot_filenames": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "symbols": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "type": "object"
    }
  },
  "required": [
    "id",
    "loader_version",
    "loader_profile_key",
    "evidence"
  ],
  "title": "FirmwareTrainProfile",
  "type": "object"
}
