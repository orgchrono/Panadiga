{
  "$defs": {
    "ClaimEvidence": {
      "additionalProperties": false,
      "description": "Evidence bundle bound to one architectural entity or model claim axis.",
      "properties": {
        "notes": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceSource"
          },
          "type": "array"
        },
        "tier": {
          "$ref": "#/$defs/EvidenceTier"
        }
      },
      "required": [
        "tier"
      ],
      "type": "object"
    },
    "EvidenceSource": {
      "additionalProperties": false,
      "description": "Primary source reference justifying a claim in a hardware profile.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "notes": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "type": "string"
        },
        "sha256": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "type": "object"
    },
    "EvidenceTier": {
      "description": "Empirical confidence tier attached to each individual hardware/firmware claim.",
      "oneOf": [
        {
          "const": "community_unverified",
          "description": "T0: Forum report, size heuristic, or unverified note (C0 read-only unless offline LabOverride).",
          "type": "string"
        },
        {
          "const": "service_manual_only",
          "description": "T1: Verified against official Matsushita/Panasonic service manuals or schematics (no binary dump).",
          "type": "string"
        },
        {
          "const": "official_frm_verified",
          "description": "T2: Verified from an official `.FRM` / CDN firmware package (proves train/TOC/load VA, not NOR layout).",
          "type": "string"
        },
        {
          "const": "physical_dump_verified",
          "description": "T3: Verified from a full physical chip dump with SHA-256 and static layout analysis.",
          "type": "string"
        },
        {
          "const": "bench_verified",
          "description": "T4: Operated and verified live on bench hardware with captured telemetry and before/after hashes.",
          "type": "string"
        }
      ]
    },
    "ModelClaims": {
      "additionalProperties": false,
      "description": "Per-axis provenance matrix attached to each DIGA model variant.",
      "properties": {
        "board": {
          "$ref": "#/$defs/ClaimEvidence"
        },
        "eeprom": {
          "$ref": "#/$defs/ClaimEvidence"
        },
        "flash_chip": {
          "$ref": "#/$defs/ClaimEvidence"
        },
        "nor_layout": {
          "$ref": "#/$defs/ClaimEvidence"
        },
        "train": {
          "$ref": "#/$defs/ClaimEvidence"
        }
      },
      "required": [
        "board",
        "flash_chip",
        "nor_layout",
        "train",
        "eeprom"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Top-level model manifest pointing strictly to normalized hardware/train/layout references.",
  "properties": {
    "board_ref": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "claims": {
      "$ref": "#/$defs/ModelClaims"
    },
    "exact_aliases": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "family_label": {
      "type": "string"
    },
    "fixture_ref": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "hw_code": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "model_id": {
      "type": "string"
    },
    "nor_layout_ref": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "region_suffix": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "series": {
      "type": "string"
    },
    "train_ref": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "tv_standard": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "model_id",
    "family_label",
    "series",
    "claims"
  ],
  "title": "ModelProfileManifest",
  "type": "object"
}
