{
  "timeouts_ms": {
    "probe_fast": 1500,
    "ctrl_short": 2000,
    "query_default": 3000,
    "handshake": 4000,
    "uart_short": 5000,
    "uart_medium": 8000,
    "fmu_short": 10000,
    "bus_sweep": 12000,
    "capture_medium": 15000,
    "logic_sweep": 18000,
    "fmu_sweep": 20000,
    "fmu_batch": 22000,
    "capture_long": 32000,
    "wdt_ceiling": 185000
  },
  "pinout": [
    { "key": "pin1", "manual_pin": 1, "physical_pin": 1, "pico_gpio": "GP26 (ADC0 / Pin 31)" },
    { "key": "pin2", "manual_pin": 2, "physical_pin": 2, "pico_gpio": "GP5 (Pin 7)" },
    { "key": "pin3", "manual_pin": 3, "physical_pin": 3, "pico_gpio": "GP4 (Pin 6)" },
    { "key": "pin4", "manual_pin": 4, "physical_pin": 4, "pico_gpio": "GND (Pin 38)" },
    { "key": "pin5", "manual_pin": 5, "physical_pin": 5, "pico_gpio": "GP3 (Pin 5)" },
    { "key": "pin6", "manual_pin": 6, "physical_pin": 6, "pico_gpio": "GP2 (Pin 4)" }
  ],
  "breakin_modes": [
    { "key": "mode0", "mode": 0, "badge_variant": "secondary" },
    { "key": "mode1", "mode": 1, "badge_variant": "secondary" },
    { "key": "mode2", "mode": 2, "badge_variant": "success" },
    { "key": "mode3", "mode": 3, "badge_variant": "warning" }
  ],
  "flash_geometries": [
    { "key": "mb2", "size_mb": 2, "microsector_range": "SA31..SA34" },
    { "key": "mb4", "size_mb": 4, "microsector_range": "SA63..SA70" },
    { "key": "mb8", "size_mb": 8, "microsector_range": "SA134..SA141" },
    { "key": "mb16", "size_mb": 16, "microsector_range": "SA127" }
  ],
  "commands": [
    {
      "id": "PINCHECK",
      "category": "electrical",
      "syntax": "PINCHECK",
      "timeout": "handshake"
    },
    {
      "id": "BUSDIAG",
      "category": "electrical",
      "syntax": "BUSDIAG",
      "timeout": "bus_sweep"
    },
    {
      "id": "SNIFF",
      "category": "electrical",
      "syntax": "SNIFF [ms]",
      "default_arg": "250",
      "options": [["w250", "250"], ["w1000", "1000"], ["w3000", "3000"]],
      "timeout": "uart_short"
    },
    {
      "id": "ISOLATE",
      "category": "electrical",
      "syntax": "ISOLATE",
      "timeout": "probe_fast"
    },
    {
      "id": "ENGAGE",
      "category": "electrical",
      "syntax": "ENGAGE",
      "timeout": "probe_fast"
    },
    {
      "id": "RESET",
      "category": "electrical",
      "syntax": "RESET",
      "timeout": "ctrl_short"
    },
    {
      "id": "IDENTIFY",
      "category": "ocd_flash",
      "syntax": "IDENTIFY [PASSIVE|NORMAL|JIG] [ms]",
      "timeout": "handshake"
    },
    {
      "id": "BREAK_IN",
      "category": "ocd_flash",
      "syntax": "BREAK_IN [0..3]",
      "default_arg": "2",
      "options": [["m0", "0"], ["m1", "1"], ["m2", "2"], ["m3", "3"]],
      "timeout": "query_default"
    },
    {
      "id": "JOB",
      "category": "ocd_flash",
      "syntax": "JOB [STATUS|NVRAM_CLEAN CONFIRM|BGO_APPLY CONFIRM|VAULT_BACKUP]",
      "default_arg": "STATUS",
      "options": [["status", "STATUS"], ["vault", "VAULT_BACKUP"]],
      "dangerous": true,
      "timeout": "logic_sweep"
    },
    {
      "id": "AUTODETECT",
      "category": "ocd_flash",
      "syntax": "AUTODETECT",
      "timeout": "query_default"
    },
    {
      "id": "CFI",
      "category": "ocd_flash",
      "syntax": "CFI",
      "timeout": "query_default"
    },
    {
      "id": "FLASH_SIZE",
      "category": "ocd_flash",
      "syntax": "FLASH_SIZE [2|4|8|16]",
      "default_arg": "8",
      "options": [["mb2", "2"], ["mb4", "4"], ["mb8", "8"], ["mb16", "16"]],
      "timeout": "ctrl_short"
    },
    {
      "id": "DUMP",
      "category": "ocd_flash",
      "syntax": "DUMP <hex_addr> <words>",
      "default_arg": "{{AM34_NVRAM_BASE_HEX}} 16",
      "options": [
        ["nvram", "{{AM34_NVRAM_BASE_HEX}} 16"],
        ["bootloader", "{{AM34_FLASH_BASE_HEX}} 16"],
        ["sram", "{{AM34_SRAM_LOADER_BASE_HEX}} 16"]
      ],
      "timeout": "uart_medium"
    },
    {
      "id": "BOOTCAP",
      "category": "uart_fmu",
      "syntax": "BOOTCAP [ms]",
      "default_arg": "7500",
      "options": [["s3", "3000"], ["s7_5", "7500"], ["s15", "15000"]],
      "timeout": "capture_long"
    },
    {
      "id": "UARTMON",
      "category": "uart_fmu",
      "syntax": "UARTMON [ms]",
      "default_arg": "5000",
      "options": [["s2", "2000"], ["s5", "5000"], ["s10", "10000"]],
      "timeout": "capture_long"
    },
    {
      "id": "JIGBOOT",
      "category": "uart_fmu",
      "syntax": "JIGBOOT [ms]",
      "default_arg": "7500",
      "options": [["s5", "5000"], ["s7_5", "7500"]],
      "timeout": "capture_long"
    },
    {
      "id": "JIGPIN",
      "category": "uart_fmu",
      "syntax": "JIGPIN [LOW|HIZ|STATUS]",
      "default_arg": "STATUS",
      "options": [["status", "STATUS"], ["low", "LOW"], ["hiz", "HIZ"]],
      "timeout": "probe_fast"
    },
    {
      "id": "BAUD",
      "category": "uart_fmu",
      "syntax": "BAUD [{{DEFAULT_BAUD_RATE}}|57600|38400|19200|9600]",
      "default_arg": "{{DEFAULT_BAUD_RATE}}",
      "options": [
        ["b115200", "{{DEFAULT_BAUD_RATE}}"],
        ["b57600", "57600"],
        ["b38400", "38400"],
        ["b19200", "19200"],
        ["b9600", "9600"]
      ],
      "timeout": "query_default"
    },
    {
      "id": "FRAMING",
      "category": "uart_fmu",
      "syntax": "FRAMING [8N1|8E1|8O1]",
      "default_arg": "8N1",
      "options": [["8n1", "8N1"], ["8e1", "8E1"], ["8o1", "8O1"]],
      "timeout": "probe_fast"
    },
    {
      "id": "BAUDSCAN",
      "category": "uart_fmu",
      "syntax": "BAUDSCAN [ms] [NORMAL|JIG] [APPLY]",
      "default_arg": "3500 NORMAL",
      "options": [["normal3_5", "3500 NORMAL"], ["jig4_0", "4000 JIG"]],
      "timeout": "uart_medium"
    },
    {
      "id": "UARTSTREAM",
      "category": "uart_fmu",
      "syntax": "UARTSTREAM [ms] [NORMAL|JIG[:ms]|NOPULL]",
      "default_arg": "8000 JIG:350",
      "options": [["jig8", "8000 JIG:350"], ["normal8", "8000 NORMAL"], ["passive5", "5000"]],
      "timeout": "capture_long"
    },
    {
      "id": "HEXCAP",
      "category": "uart_fmu",
      "syntax": "HEXCAP [ms] [NORMAL|JIG[:ms]|NOPULL]",
      "default_arg": "5000 JIG:350",
      "options": [["jig5", "5000 JIG:350"], ["normal4", "4000 NORMAL"]],
      "timeout": "capture_long"
    },
    {
      "id": "UARTTXHEX",
      "category": "uart_fmu",
      "syntax": "UARTTXHEX <hex> [BRK] [rx_ms]",
      "default_arg": "0D0A 1500",
      "options": [["crlf", "0D0A 1500"], ["help", "68656C700D 2000"]],
      "timeout": "uart_short"
    },
    {
      "id": "WAITTX",
      "category": "uart_fmu",
      "syntax": "WAITTX <ms> <NORMAL|JIG[:ms]|NOPULL> <trigger> <hex|BRK> [post_ms]",
      "default_arg": "8000 JIG:350 \"wait 1\" 0D 4000",
      "options": [
        ["wait1", "8000 JIG:350 \"wait 1\" 0D 4000"],
        ["hitkey", "20000 JIG:350 \"Hit Any Key\" 1B0D 6000"]
      ],
      "timeout": "capture_long"
    },
    {
      "id": "PWRTRACE",
      "category": "electrical",
      "syntax": "PWRTRACE [ms] [NORMAL|JIG[:ms]|NOPULL]",
      "default_arg": "4000 JIG:350",
      "options": [["jig4", "4000 JIG:350"], ["normal3", "3000 NORMAL"]],
      "timeout": "capture_medium"
    },
    {
      "id": "BOOTTRACE",
      "category": "electrical",
      "syntax": "BOOTTRACE [ms] [NORMAL|JIG[:ms]|NOPULL]",
      "default_arg": "4500 JIG:2500",
      "options": [["jig2500", "4500 JIG:2500"], ["normal4500", "4500 NORMAL"]],
      "timeout": "capture_long"
    },
    {
      "id": "PIOLOGIC",
      "category": "electrical",
      "syntax": "PIOLOGIC [ms] [NORMAL|JIG[:ms]|NOPULL] [khz] [CTRL]",
      "default_arg": "4000 JIG:350",
      "options": [
        ["jig4", "4000 JIG:350"],
        ["jig2500ctrl", "4000 JIG:2500 1000 CTRL"],
        ["normal4", "4000 NORMAL"],
        ["passive2", "2000"]
      ],
      "timeout": "logic_sweep"
    },
    {
      "id": "SDSNIFF",
      "category": "electrical",
      "syntax": "SDSNIFF [ms] [NORMAL|JIG[:ms]|NOPULL] [LEN:64|512]",
      "default_arg": "4000 NORMAL",
      "options": [
        ["normal4", "4000 NORMAL"],
        ["jig4", "4000 JIG:350"],
        ["acmd13", "4000 NORMAL LEN:64"]
      ],
      "timeout": "logic_sweep"
    },
    {
      "id": "JIGSWEEP",
      "category": "electrical",
      "syntax": "JIGSWEEP [HOLD|DELAY|PREBOOT] [ms..]",
      "default_arg": "HOLD",
      "options": [["hold", "HOLD"], ["delay", "DELAY"], ["preboot", "PREBOOT"]],
      "timeout": "bus_sweep"
    },
    {
      "id": "PANARSP",
      "category": "uart_fmu",
      "syntax": "PANARSP [ms] [boot] [MAGIC] [WAIT:<trig>] <PROBESEQ|REGS|G|Z0|Z1|MEM:addr,len|XMEM:addr,len|DUMPNOR[:addr[,len]]|PASSTHROUGH|CALL:addr|HEX:..>",
      "default_arg": "6000 JIG:350 PROBESEQ",
      "options": [
        ["probeJig", "6000 JIG:350 PROBESEQ"],
        ["regsDecode", "5000 JIG:350 REGS"],
        ["magicG", "6000 JIG:350 MAGIC G"],
        ["wait1Probe", "8000 JIG:350 \"WAIT:wait 1\" PROBESEQ"],
        ["mem515", "4000 MEM:{{DEV_SERIAL_MEM_PROBE_ADDR}},10"],
        ["xmem840", "4000 XMEM:{{AM34_FLASH_UNCACHED_ADDR}},40"],
        ["dumpnor", "{{WDT_DUMPNOR_CAPTURE_WINDOW_MS}} DUMPNOR {{AM34_FLASH_UNCACHED_ADDR}} {{AM34_FLASH_SIZE_HEX_NO_PREFIX}}"]
      ],
      "timeout": "wdt_ceiling"
    },
    {
      "id": "DIAGWATCH",
      "category": "uart_fmu",
      "syntax": "DIAGWATCH [ms] [NORMAL|JIG[:ms]|NOPULL] [AUTO|BYPASS|READ[:addr[,len]]|WRITE:<addr,val>|FORMAT|DUMP|JUMP:<addr>|ERASE:<nvram_addr>|QUIT|NONE] [RELEASE|HOLD] [WAKE[:ms]]",
      "default_arg": "25000 JIG:2500 AUTO RELEASE",
      "options": [
        ["autoBypass", "25000 JIG:2500 AUTO RELEASE"],
        ["readNvram", "25000 JIG:2500 READ:{{AM34_NVRAM_UNCACHED_ADDR}},20 RELEASE"],
        ["readMem", "25000 JIG:2500 READ RELEASE"],
        ["writeMem", "25000 JIG:2500 NORUNLOCK:CONFIRM_UPPER_NOR WRITE RELEASE"],
        ["formatBgo", "35000 JIG:2500 NORUNLOCK:CONFIRM_UPPER_NOR FORMAT RELEASE"],
        ["dumpNor", "{{WDT_DUMPNOR_CAPTURE_WINDOW_MS}} JIG:2500 DUMP RELEASE"],
        ["passive", "15000 NORMAL NONE RELEASE"],
        ["wakeJig", "25000 JIG:2500 AUTO RELEASE WAKE:30000"]
      ],
      "timeout": "wdt_ceiling"
    },
    {
      "id": "IRTX",
      "category": "uart_fmu",
      "syntax": "IRTX <RED|GREEN|YELLOW|BLUE|POWER|AUDIO|DISPLAY|SERV|ND2|0..9|sub:cmd> [GP6..9|16..22] [repeat]",
      "default_arg": "RED GP6 2",
      "options": [
        ["red", "RED GP6 2"],
        ["power", "POWER GP6 2"],
        ["serv", "SERV GP6 2"],
        ["nd2", "ND2 GP6 2"],
        ["audio", "AUDIO GP6 2"],
        ["display", "DISPLAY GP6 2"]
      ],
      "timeout": "probe_fast"
    },
    {
      "id": "DRVPANA",
      "category": "uart_fmu",
      "syntax": "DRVPANA [ms] [NORMAL|JIG[:ms]|NOPULL] [NOPASS] <cmd...>",
      "default_arg": "DSCREG",
      "options": [
        ["dscreg", "DSCREG"],
        ["passUnlock", "{{MATSHITA_PASS_UNLOCK_CMD}}"],
        ["fep", "FEP"],
        ["start", "START"],
        ["pon", "PON"],
        ["stop", "STOP"]
      ],
      "timeout": "capture_medium"
    },
    {
      "id": "BRIDGE",
      "category": "uart_fmu",
      "syntax": "BRIDGE [baud] [NORMAL|JIG[:ms]|NOPULL]",
      "default_arg": "{{DEFAULT_BAUD_RATE}} JIG:350",
      "options": [
        ["jig115200", "{{DEFAULT_BAUD_RATE}} JIG:350"],
        ["passive115200", "{{DEFAULT_BAUD_RATE}}"]
      ],
      "dangerous": true,
      "timeout": "capture_medium"
    },
    {
      "id": "FMUSCAN",
      "category": "uart_fmu",
      "syntax": "FMUSCAN [modo]",
      "default_arg": "all",
      "options": [["all", "all"], ["m0", "0"], ["m1", "1"], ["m2", "2"], ["m3", "3"]],
      "timeout": "fmu_sweep"
    },
    {
      "id": "FMUTEST",
      "category": "uart_fmu",
      "syntax": "FMUTEST <hex>",
      "default_arg": "0D",
      "options": [["cr", "0D"], ["crlf", "0D0A"], ["help", "3F0D"]],
      "timeout": "fmu_short"
    },
    {
      "id": "FMUBATCH",
      "category": "uart_fmu",
      "syntax": "FMUBATCH [step]",
      "default_arg": "",
      "timeout": "fmu_batch"
    },
    {
      "id": "UARTSEND",
      "category": "uart_fmu",
      "syntax": "UARTSEND <texto>",
      "default_arg": "help",
      "options": [["help", "help"], ["ver", "ver"], ["info", "info"]],
      "timeout": "uart_short"
    },
    {
      "id": "UARTPROBE",
      "category": "uart_fmu",
      "syntax": "UARTPROBE [0..8]",
      "default_arg": "5",
      "options": [["m5", "5"], ["m6", "6"], ["m7", "7"]],
      "timeout": "uart_medium"
    },
    {
      "id": "PING",
      "category": "probe",
      "syntax": "PING",
      "timeout": "probe_fast"
    },
    {
      "id": "STATUS",
      "category": "probe",
      "syntax": "STATUS",
      "timeout": "probe_fast"
    },
    {
      "id": "BANNER",
      "category": "probe",
      "syntax": "BANNER",
      "timeout": "probe_fast"
    },
    {
      "id": "WDT",
      "category": "probe",
      "syntax": "WDT",
      "timeout": "probe_fast"
    },
    {
      "id": "LED",
      "category": "probe",
      "syntax": "LED <modo>",
      "default_arg": "IDLE",
      "options": [
        ["idle", "IDLE"],
        ["active", "ACTIVE"],
        ["gdb", "GDB"],
        ["fault", "FAULT"],
        ["off", "OFF"],
        ["auto", "AUTO"]
      ],
      "timeout": "probe_fast"
    },
    {
      "id": "BOOTSEL",
      "category": "probe",
      "syntax": "BOOTSEL",
      "dangerous": true,
      "timeout": "probe_fast"
    },
    {
      "id": "SELFTEST",
      "category": "probe",
      "syntax": "SELFTEST [LOOPBACK]",
      "options": [["loopback", "LOOPBACK"]],
      "timeout": "probe_fast"
    },
    {
      "id": "TARGET_PROFILE",
      "category": "ocd_flash",
      "syntax": "TARGET_PROFILE [DMR-EH55|DMR-ES35V|DMR-EZ485V|DMR-ES10]",
      "default_arg": "DMR-EH55",
      "timeout": "ctrl_short"
    },
    {
      "id": "VAULT",
      "category": "ocd_flash",
      "syntax": "VAULT [STATUS|LIST|DUMP <1..3>|ERASE <1..3> CONFIRM]",
      "default_arg": "STATUS",
      "timeout": "query_default"
    },
    {
      "id": "BLACKBOX",
      "category": "probe",
      "syntax": "BLACKBOX [STATUS|DUMP|SNAP [msg]|CLEAR CONFIRM]",
      "default_arg": "STATUS",
      "timeout": "query_default"
    },
    {
      "id": "PROBE_CFG",
      "category": "probe",
      "syntax": "PROBE_CFG [STATUS|CAL_ADC <gain_ppm> [offset_mv]|RESET CONFIRM]",
      "default_arg": "STATUS",
      "timeout": "probe_fast"
    },
    {
      "id": "RECIPE",
      "category": "ocd_flash",
      "syntax": "RECIPE [STATUS|LIST|VERIFY]",
      "default_arg": "STATUS",
      "timeout": "probe_fast"
    },
    {
      "id": "BGO_INSPECT",
      "category": "ocd_flash",
      "syntax": "BGO_INSPECT",
      "timeout": "query_default"
    },
    {
      "id": "EEMUL_INSPECT",
      "category": "ocd_flash",
      "syntax": "EEMUL_INSPECT",
      "timeout": "query_default"
    },
    {
      "id": "IRRX",
      "category": "electrical",
      "syntax": "IRRX [ms] [GP6..9|16..22]",
      "default_arg": "5000 GP7",
      "timeout": "capture_medium"
    },
    {
      "id": "SERVMACRO",
      "category": "electrical",
      "syntax": "SERVMACRO <SERVICE_MODE|SELF_CHECK|OPTICAL_CAL|ERR_HISTORY|RELEASE> [GPn]",
      "default_arg": "SELF_CHECK",
      "timeout": "capture_medium"
    },
    {
      "id": "MMIO_SNAP",
      "category": "ocd_flash",
      "syntax": "MMIO_SNAP [DIFF]",
      "timeout": "query_default"
    },
    {
      "id": "PWROSC",
      "category": "electrical",
      "syntax": "PWROSC [ms]",
      "default_arg": "500",
      "timeout": "uart_short"
    },
    {
      "id": "TBUSSNIFF",
      "category": "uart_fmu",
      "syntax": "TBUSSNIFF [ms]",
      "default_arg": "2000",
      "timeout": "uart_medium"
    },
    {
      "id": "M0KEEPALIVE",
      "category": "uart_fmu",
      "syntax": "M0KEEPALIVE [ON [1000..30000ms]|OFF|STATUS]",
      "default_arg": "STATUS",
      "options": [
        ["status", "STATUS"],
        ["on10s", "ON 10000"],
        ["off", "OFF"]
      ],
      "timeout": "probe_fast"
    },
    {
      "id": "I2C_SCAN",
      "category": "electrical",
      "syntax": "I2C_SCAN",
      "timeout": "query_default"
    },
    {
      "id": "EEPROM",
      "category": "ocd_flash",
      "syntax": "EEPROM <INFO|READ <addr> <off> <len>|WRITE <addr> <off> <hex> CONFIRM>",
      "default_arg": "INFO",
      "timeout": "query_default"
    },
    {
      "id": "USBMODE",
      "category": "probe",
      "syntax": "USBMODE [SINGLE|DUAL_CDC|STATUS]",
      "default_arg": "STATUS",
      "timeout": "probe_fast"
    },
    {
      "id": "BLE",
      "category": "probe",
      "syntax": "BLE [STATUS|DISCONNECT]",
      "default_arg": "STATUS",
      "timeout": "probe_fast"
    },
    {
      "id": "BLE_NOR_AUTH",
      "category": "probe",
      "syntax": "BLE_NOR_AUTH <CONFIRM [1..16]|REVOKE|STATUS>",
      "default_arg": "STATUS",
      "dangerous": true,
      "timeout": "probe_fast"
    }
  ]
}
